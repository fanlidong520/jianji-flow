{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jianji-flow visual selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "candidate_manifest", "selections"],
  "properties": {
    "version": {"const": "0.1"},
    "candidate_manifest": {"type": "string", "minLength": 1},
    "selections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reviewer", "reason"],
        "properties": {
          "role": {"type": "string"},
          "caption": {"type": "string"},
          "candidate_id": {"type": "string", "minLength": 1},
          "reviewer": {"enum": ["human", "codex-vision"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
